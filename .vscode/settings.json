{
  "json.schemas": [
    {
      "fileMatch": [
        "pack.mcmeta"
      ],
      "url": "https://raw.githubusercontent.com/Levertion/minecraft-json-schemas/master/java/data/pack.mcmeta.json",
      "schema": {
        "type": "object",
        "$schema": "http://json-schema.org/draft-07/schema",
        "$id": "https://raw.githubusercontent.com/Levertion/minecraft-json-schemas/master/java/data/pack.mcmeta.json",
        "title": "Resource pack information",
        "description": "Information about a resource pack",
        "additionalProperties": false,
        "defaultSnippets": [
          {
            "label": "Default (resource) pack.mcmeta",
            "body": {
              "pack": {
                "description": "${1:${TM_DIRECTORY/(?:.*[\\\\/])?([^\\\\/]*)/$1/}}: $2",
                "pack_format": 4
              }
            }
          }
        ],
        "properties": {
          "pack": {
            "type": "object",
            "additionalProperties": false,
            "description": "Information about the resource pack",
            "properties": {
              "pack_format": {
                "default": 69.0,
                "type": "number",
                "title": "Resource pack version",
                "description": "https://minecraft.wiki/w/Pack_format",
                "maximum": 69.0,
                "minimum": 1
              },
              "supported_formats": {
                "default": [
                  35,
                  69.0
                ],
                "type": "array",
                "title": "Supported pack_formats",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "default": 69.0,
                  "type": "number",
                  "title": "Resource pack version",
                  "description": "https://minecraft.wiki/w/Pack_format",
                  "maximum": 69.0,
                  "minimum": 1
                }
              },
              "description": {
                "type": "string",
                "title": "Pack description",
                "description": "The description for this pack. Any text which doesn't fit on two lines will be removed"
              }
            },
            "required": [
              "pack_format"
            ]
          },
          "language": {
            "type": "object",
            "title": "Custom languages",
            "defaultSnippets": [
              {
                "body": {
                  "$1": {
                    "name": "$2",
                    "region": "$3"
                  }
                }
              }
            ],
            "description": "Each sub-object is the internal code for the language, which the pack's lang folder has a language file with the name <code>.lang",
            "additionalProperties": {
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Language name",
                  "description": "The displayed name of the custom language, e.g. English"
                },
                "region": {
                  "type": "string",
                  "title": "Language Region",
                  "description": "The place where this version of the language is spoken (area or country). E.g. United Kingdom"
                },
                "bidirectional": {
                  "type": "boolean",
                  "default": false,
                  "title": "RTL support?",
                  "description": "When true, the language reads right to left"
                }
              }
            }
          }
        },
        "required": [
          "pack"
        ]
      }
    },
  ],
  "files.associations": {
    "*.mcmeta": "json",
    "en_us.json": "jsonc"
  }
}
